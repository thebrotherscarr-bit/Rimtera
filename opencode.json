{
  "$schema": "https://opencode.ai",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local Engine",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:14b": {
          "name": "Qwen Code Local",
          "tool_call": true
        }
      }
    }
  },
  "model": "ollama/qwen3.5:14b",
  "mcpServers": {
    "rea-agents": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@latest",
        "server"
      ]
    }
  }
}