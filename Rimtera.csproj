<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Single source of truth for the release version; .github/workflows/version.yml validates it. -->
    <Version>0.2.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- tools/ holds external repos and asset scripts, not game code. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="rea\**" />
    <!-- Local agent worktrees (Claude Code) are full copies of the repo; never compile them into the game. -->
    <Compile Remove=".claude\**" />
    <None Remove=".claude\**" />
    <None Remove="rea\**" />
    <!-- Rimtera\ holds a local ComfyUI install (art generation), not game code. -->
    <Compile Remove="Rimtera\**" />
    <None Remove="Rimtera\**" />
    <Content Remove="Rimtera\**" />
    <EmbeddedResource Remove="Rimtera\**" />
    <None Include="Assets\Sprites\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Recorded voice/sound clips (tools/voice-recorder writes them); each replaces the synthesised effect of the same name. -->
    <None Include="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Music\*.ogg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\Ambience\*.ogg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The title screen's Credits read this file (PU-24). -->
    <None Include="docs\CREDITS.md" Link="CREDITS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
</Project>
